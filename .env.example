# ShadowBuilder AI Environment Configuration
# Copy this file to .env and configure your values.
# NEVER commit .env to version control.

# LLM Provider Configuration
# Supported providers: "gemini" (recommended free tier), "openai", or "fixture" (deterministic demo/fallback)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Frontend & Backend Origin
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Storage
DATABASE_URL=sqlite:///./shadowbuilder.db
ARTIFACTS_DIR=./artifacts

# Optional Website Extraction Key (Default uses safe built-in requests + BeautifulSoup)
FIRECRAWL_API_KEY=

# Execution Sandbox Mode
# Values: "template" (Constrained Template Mode - safe fallback without Docker), "docker"
SANDBOX_MODE=template
