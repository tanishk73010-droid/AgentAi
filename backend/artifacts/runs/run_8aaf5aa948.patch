--- a/tests/test_exporter.py
+++ b/tests/test_exporter.py
@@ -0,0 +1,34 @@
+import json
+import pytest
+from src.exporter import export_as_json, generate_metrics_report, export_metrics_report_json
+from src.metrics import calculate_summary, detect_threshold_anomalies
+
+
+def test_export_as_json_valid():
+    data = {'status': 'ok', 'score': 99}
+    output = export_as_json(data)
+    parsed = json.loads(output)
+    assert parsed['status'] == 'ok'
+    assert parsed['score'] == 99
+
+
+def test_export_as_json_invalid_type():
+    with pytest.raises(ValueError):
+        export_as_json(['not', 'a', 'dict'])
+
+
+def test_generate_metrics_report():
+    summary = calculate_summary([10.0, 20.0, 30.0])
+    anomalies = detect_threshold_anomalies([10.0, 20.0, 30.0], 25.0)
+    report = generate_metrics_report(summary, anomalies)
+    assert report['integrity_status'] == 'VERIFIED'
+    assert report['has_anomalies'] is True
+    assert report['anomalies_detected'] == [30.0]
+
+
+def test_export_metrics_report_json():
+    summary = calculate_summary([5.0, 15.0])
+    raw_json = export_metrics_report_json(summary, [])
+    parsed = json.loads(raw_json)
+    assert parsed['integrity_status'] == 'VERIFIED'
+    assert parsed['has_anomalies'] is False
